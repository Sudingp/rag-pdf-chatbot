# Settings for the hosted-LLM readers. Copy to .env and fill in ONE option.
# NEVER commit .env (it is in .gitignore).

# ---- Option A: any OpenAI-compatible provider -> reader "llm" -------------
# Google Gemini (free tier, key from aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=<your Gemini API key>
LLM_MODEL=gemini-2.5-flash

# Groq (free tier, key from console.groq.com):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=<your Groq API key>
# LLM_MODEL=llama-3.3-70b-versatile

# Local Ollama (free, offline; run `ollama pull qwen2.5:7b` first):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ---- Option B: Azure OpenAI -> reader "azure" ------------------------------
# AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<key 1 from "Keys and Endpoint">
# AZURE_OPENAI_DEPLOYMENT=<your deployment name, e.g. gpt-4o-mini>
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Optional: a different model as the DeepEval judge ---------------------
# evals/deepeval_eval.py uses the LLM_* model above unless these are set.
# A stronger judge than the reader gives fairer scores.
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_API_KEY=<your Groq API key>
# JUDGE_MODEL=llama-3.3-70b-versatile
